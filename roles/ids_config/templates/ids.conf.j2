#!/bin/sh
# Managed by Ansible - IDS configuration
# monitor.sh, baseline.sh and alert.sh read this file with -c. The
# variable names match config/ids.conf.
# Format: KEY=VALUE (no spaces around =)

# System Identification
HOSTNAME="{{ ansible_hostname }}"

# Paths. IDS_HOME is where the monitor keeps logs and state; the scripts
# themselves are installed under {{ ids_base_path }}.
IDS_HOME="{{ ids_log_path }}"
BASELINE_FILE="{{ ids_baseline_file }}"
ALERT_LOG="{{ ids_alert_log }}"
MONITOR_LOG="{{ ids_monitor_log }}"

# Log rotation
MAX_LOG_SIZE={{ ids_max_log_size }}
MAX_LOG_FILES={{ ids_max_log_files }}

# Network Monitoring
PORT_SCAN_THRESHOLD={{ ids_port_scan_threshold }}
BRUTE_FORCE_THRESHOLD={{ ids_brute_force_threshold }}
OUTBOUND_PORT_WHITELIST="{{ ids_outbound_port_whitelist }}"

# File System Monitoring
CRITICAL_FILES="{{ ids_critical_files | join(' ') }}"
CRITICAL_DIRS="{{ ids_critical_dirs | join(' ') }}"
WEB_DIRS="{{ ids_web_dirs | join(' ') }}"

# Authentication
MAX_FAILED_LOGINS={{ ids_max_failed_logins }}
SUDO_ANOMALY_THRESHOLD={{ ids_sudo_anomaly_threshold }}
AUTH_WINDOW={{ ids_auth_window }}
SUDO_WINDOW={{ ids_sudo_window }}

# Process Monitoring
CPU_THRESHOLD={{ ids_cpu_threshold }}
MEM_THRESHOLD={{ ids_mem_threshold }}
DISK_THRESHOLD={{ ids_disk_threshold }}
PROC_COUNT_THRESHOLD={{ ids_proc_count_threshold }}

# Cryptominer signatures
MINER_PATTERNS="{{ ids_miner_patterns }}"

# Timing
CHECK_INTERVAL={{ ids_check_interval }}
BASELINE_AGE_WARN={{ ids_baseline_age_warn }}

# Severity Levels
SEV_CRITICAL="critical"
SEV_HIGH="high"
SEV_MEDIUM="medium"
SEV_LOW="low"
SEV_INFO="info"

# Alert Methods
ALERT_TO_SYSLOG={{ 1 if ids_alert_to_syslog | bool else 0 }}
ALERT_TO_FILE={{ 1 if ids_alert_to_file | bool else 0 }}
ALERT_TO_STDOUT=0

# alert.sh destinations; its -w and -e options still take precedence
{% if ids_alert_webhook | default('') %}
WEBHOOK_URL=${WEBHOOK_URL:-"{{ ids_alert_webhook }}"}
{% endif %}
{% if ids_alert_email | default('') %}
EMAIL_TO=${EMAIL_TO:-"{{ ids_alert_email }}"}
{% endif %}
